# ============================================================
# Loan Performance Intelligence Engine — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── LLM Copilot (DeepSeek) ──────────────────────────────────
# Get your key from: https://platform.deepseek.com/api_keys
# The copilot works without a key (smart mock responses),
# but a real key gives richer LLM-generated reviewer notes.
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ── Alternative LLM providers (optional) ────────────────────
# If you prefer OpenRouter instead of DeepSeek:
# OPENROUTER_API_KEY=your-openrouter-key-here

# ── Override model or endpoint (optional) ────────────────────
# LLM_MODEL=deepseek-chat          # default when DEEPSEEK_API_KEY is set
# LLM_BASE_URL=https://api.deepseek.com/v1
